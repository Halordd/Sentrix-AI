[Unit]
Description=SENTRIX Worker (placeholder)
After=network.target

[Service]
Type=simple
User=sentrixadmin
Group=sentrixadmin
WorkingDirectory=/home/sentrixadmin/sentrix-worker
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /home/sentrixadmin/sentrix-worker/main.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
