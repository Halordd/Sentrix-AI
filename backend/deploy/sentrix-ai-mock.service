[Unit]
Description=SENTRIX AI mock analysis endpoint
After=network.target

[Service]
Type=simple
User=sentrixadmin
Group=sentrixadmin
WorkingDirectory=/home/sentrixadmin/sentrix-ai
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /home/sentrixadmin/sentrix-ai/main.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
